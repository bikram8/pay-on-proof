# Copy this file to .env and fill in your values. NEVER commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID shown after you add a webhook URL to your sandbox app
PAYPAL_WEBHOOK_ID=

# Currency used for all sandbox payments
CURRENCY=USD

# Where PayPal sends the funder after approving payment (your frontend or backend URL)
PUBLIC_BASE_URL=http://localhost:8000

# LLM used for the visual review step (Phase 2). Leave empty to use the stub.
LLM_PROVIDER=
LLM_API_KEY=

# Database (SQLite locally; use a Postgres URL on Render)
DATABASE_URL=sqlite:///./payonproof.db

# Policy thresholds
AUTO_APPROVE_THRESHOLD=0.85
HUMAN_REVIEW_THRESHOLD=0.5
MAX_AUTO_PAYOUT=500
