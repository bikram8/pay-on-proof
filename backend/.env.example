# Copy this file to .env and fill in your values. NEVER commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID shown after you add a webhook URL to your sandbox app
PAYPAL_WEBHOOK_ID=

# Currency used for all sandbox payments
CURRENCY=USD

# Where PayPal sends the funder after approving payment (your frontend or backend URL)
PUBLIC_BASE_URL=http://localhost:8000

# A vision model reviews each proof photo. Set at least one key; with none, every
# photo goes to human review. VISION_PROVIDER=auto uses Claude if its key is set, else Gemini.
VISION_PROVIDER=auto
# Gemini: free tier, no card needed (aistudio.google.com > Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy or rate-limited (free tier limits are low)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high: lower is faster
GEMINI_THINKING=low
# Claude: paid, prepaid credit (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5

# Database (SQLite locally; use a Postgres URL on Render)
DATABASE_URL=sqlite:///./payonproof.db

# Dashboard login (you, the single admin)
ADMIN_PASSWORD=choose_a_password
# Long random string; signs logins and worker upload links. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Where the dashboard runs (Vite dev server by default)
FRONTEND_URL=http://localhost:5173

# Policy thresholds
AUTO_APPROVE_THRESHOLD=0.85
HUMAN_REVIEW_THRESHOLD=0.5
MAX_AUTO_PAYOUT=500
